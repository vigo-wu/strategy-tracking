<?xml version="1.0" encoding="utf-8"?>
<TCStageLayout>
    <control note="控件">
        <variable note="控件">
            <item bind="panel_dry_run" name="模拟下单" note="勾选=只打日志不下单（DRY_RUN）" value="True" type="checkBox"/>
            <item bind="panel_budget" name="单笔预算" note="元；下单前再按整手取整" value="20000" type="intput"/>
            <item bind="panel_cash_ratio" name="现金占用比例" note="0~1，预留下单缓冲" value="0.8" type="intput"/>
            <item bind="panel_allow_t0" name="允许当日卖出" note="勾选=T+0（513530 ETF）；回测不锁当日仓" value="True" type="checkBox"/>
            <item bind="panel_ma_touch" name="买入 回踩容差" note="低点相对MA20，0.004=0.4%" value="0.004" type="intput"/>
            <item bind="panel_ma_break" name="买入 跌破容差" note="收盘相对MA20未跌破，0.002=0.2%" value="0.002" type="intput"/>
            <item bind="panel_vol_ratio" name="买入 缩量比例" note="量小于20均量乘此值视为缩量，0.85=85%" value="0.85" type="intput"/>
            <item bind="panel_stop_ma" name="卖出 MA止损" note="收盘跌破MA20此比例，0.008=0.8%" value="0.008" type="intput"/>
            <item bind="panel_stop_loss" name="卖出 成本止损" note="收盘相对成本回撤，0.02=2%" value="0.02" type="intput"/>
            <item bind="panel_hard_tp" name="卖出 离开均线硬止盈" note="勾选=浮盈达标且离开MA20即出；v1.0关掉会少赚，默认开" value="True" type="checkBox"/>
            <item bind="panel_take_profit" name="卖出 止盈浮盈" note="硬止盈阈值；也是回吐启动浮盈，0.015=1.5%" value="0.015" type="intput"/>
            <item bind="panel_giveback" name="卖出 回吐比例" note="须先达到止盈浮盈才启用；相对收盘最高回吐，0.008=0.8%" value="0.008" type="intput"/>
            <item bind="panel_stall_bars" name="卖出 贴线根数" note="连续贴MA20的15分钟根数，16约1日" value="16" type="intput"/>
            <item bind="panel_stall_abort" name="卖出 贴线作废浮盈" note="持仓期曾达此浮盈则不再贴线出场，0.005=0.5%" value="0.005" type="intput"/>
            <item bind="panel_scale" name="盈利后加仓" note="勾选=浮盈1.5%后下一笔回踩再买一笔预算；需账户有第二笔资金" value="True" type="checkBox"/>
        </variable>
    </control>
</TCStageLayout>
